# =====================================================================
#  CAPTCHA Solving & Verification Tool  —  environment configuration
# =====================================================================
#  Copy this file to ".env" and fill in values.  The real .env is
#  git-ignored so secrets never land in the repository.
#
#  All keys below are the PROVIDERS' OFFICIAL PUBLIC TEST KEYS.
#  They are safe to commit/share and are documented by each provider.
#  They ALWAYS pass verification, which is exactly what we want for an
#  authorized demo.  Replace with real keys only in a real deployment.
# ---------------------------------------------------------------------

# --- Google reCAPTCHA v2 (official test key pair, always passes) ---
# Docs: https://developers.google.com/recaptcha/docs/faq
RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# --- hCaptcha (official test key pair, always passes) ---
# Docs: https://docs.hcaptcha.com/#integration-testing-test-keys
HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
HCAPTCHA_SECRET_KEY=0x0000000000000000000000000000000000000000

# --- Cloudflare Turnstile (official dummy keys) ---
# Docs: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# Site key 1x... = always passes (visible). Secret 1x... = always validates.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Optional: third-party solving API (NOT used by default) ---
# The default solver is our own custom OCR engine, so this is unset.
# TWOCAPTCHA_API_KEY=

# --- Cost model (used only for the reporting dashboard) ---
# Our custom OCR solver is free; this is the illustrative per-solve cost.
CUSTOM_SOLVE_COST_USD=0.0
# Illustrative cost IF a third-party API were used (2Captcha ~ $1-3 / 1000).
THIRDPARTY_SOLVE_COST_USD=0.002
